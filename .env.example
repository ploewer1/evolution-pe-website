# Copy to .env.local for local work. On Vercel, add these in Project Settings > Environment Variables.
# All values are public (they are visible in the browser). Never put secrets here.

# The public address of the site (used for sitemap, social cards, and metadata).
NEXT_PUBLIC_SITE_URL=https://evolutionpe.com

# Only for previewing on GitHub before your domain is connected, for example /evolution-pe-website
# Leave BLANK once evolutionpe.com points at the site.
NEXT_PUBLIC_BASE_PATH=

# ---- Signup forms -------------------------------------------------------------
# Works with Formspree, Basin, or any service that accepts a JSON POST.
# Use separate forms for teachers and homeschool families to count interest independently.
# The two audience values fall back to the general one if left blank.
NEXT_PUBLIC_SIGNUP_ENDPOINT=
NEXT_PUBLIC_SIGNUP_ENDPOINT_TEACHERS=
NEXT_PUBLIC_SIGNUP_ENDPOINT_HOMESCHOOL=

# Contact form endpoint (can be the same provider, a different form).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public contact email. Also the fallback: if a signup endpoint is blank but this is set,
# the signup form opens an email to this address instead of pretending to save anything.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Product buttons ----------------------------------------------------------
# Where the beta Fitness Test Analyzer is hosted. Blank = "Try Fitness Analyzer" goes to the teacher waitlist.
NEXT_PUBLIC_ANALYZER_URL=

# A reviewed sample lesson (a PDF link or page). Blank = "Get a Free Sample Lesson" goes to the homeschool waitlist.
NEXT_PUBLIC_SAMPLE_LESSON_URL=

# ---- Optional analytics (off by default) --------------------------------------
# Your Plausible site domain, for example evolutionpe.com. Blank = no analytics script is loaded.
# Update the Privacy Policy before turning this on.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
